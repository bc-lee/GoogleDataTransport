module(name = "google_data_transport", version = "10.1.0")

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_apple", version = "3.20.1",)
bazel_dep(name = "rules_swift", version = "2.7.0")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "apple_support", version = "1.20.0")

apple_cc_configure = use_extension("@apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
use_repo(apple_cc_configure, "local_config_apple_cc", "local_config_apple_cc_toolchains")

register_toolchains("@local_config_apple_cc_toolchains//:all")

nanopb_deps = use_extension("@google_data_transport//:extensions.bzl", "nanopb_deps")

promises_deps = use_extension("@google_data_transport//:extensions.bzl", "promises_deps")

use_repo(nanopb_deps, "nanopb")

use_repo(promises_deps, "promises")
